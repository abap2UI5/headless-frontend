{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "."
  },
  "rules": {
    // --- correctness ---
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true,
    "unreachable_code": true,
    "unused_variables": true,
    "unused_types": true,
    "unused_methods": true,
    "identical_conditions": true,
    "identical_contents": true,
    "empty_statement": true,
    "ambiguous_statement": true,
    "obsolete_statement": true,
    "commented_code": true,
    "when_others_last": true,
    "constructor_visibility_public": true,
    "allowed_object_types": {
      "allowed": ["CLAS", "DEVC", "INTF"]
    },
    // --- style ---
    "exporting": true,
    "omit_parameter_name": true,
    "line_length": {
      "length": 255
    },
    "definitions_top": true,
    "contains_tab": true,
    "whitespace_end": true,
    "wrong_abapdoc_position": true,
    "sequential_blank": {
      "lines": 3
    },
    "max_one_statement": true,
    "colon_missing_space": true,
    "keyword_case": {
      "style": "upper",
      "ignoreExceptions": true,
      "ignoreLowerClassImplmentationStatement": true,
      "ignoreKeywords": []
    },
    "types_naming": {
      "pattern": "^TY_"
    },
    "object_naming": {
      "patternKind": "required",
      "clas": "^Z2UI5_CL_",
      "intf": "^Z2UI5_IF_"
    },
    "functional_writing": true,
    "no_chained_assignment": true,
    "names_no_dash": true,
    "preferred_compare_operator": true,
    "use_line_exists": true,
    "prefer_is_not": true,
    "avoid_use": {
      "define": true,
      "endselect": true,
      "execSQL": true,
      "kernelCall": true,
      "communication": true,
      "statics": true,
      "systemCall": true,
      "defaultKey": true,
      "break": true
    },

    // --- adopted from abap2UI5's rule set (zero findings when enabled) ---
    "7bit_ascii": true,
    "add_test_attributes": true,
    "aff_and_xml": true,
    "allowed_object_naming": true,
    "begin_single_include": true,
    "call_transaction_authority_check": true,
    "catch_and_raise": true,
    "cds_association_name": true,
    "cds_field_order": true,
    "cds_parser_error": true,
    "chain_mainly_declarations": true,
    "change_if_to_case": true,
    "check_abstract": true,
    "check_comments": true,
    "check_text_elements": true,
    "check_transformation_exists": true,
    "classic_exceptions_overlap": true,
    "clear_exporting_parameters": true,
    "cloud_types": true,
    "constant_classes": true,
    "cyclic_oo": {
      "skip": [
        "Z2UI5_IF_APP",
        "Z2UI5_IF_CLIENT",
        "Z2UI5_CL_UI5_ACTION",
        "Z2UI5_CL_UI5_HANDLER"
      ],
      "skipSharedMemory": true,
      "skipTestclasses": true
    },
    "dangerous_statement": {
      "deleteDynpro": true,
      "deleteReport": true,
      "deleteTextpool": true,
      "dynamicSQL": true,
      "execSQL": true,
      "exportDynpro": true,
      "generateDynpro": true,
      "generateReport": true,
      "generateSubroutine": true,
      "insertReport": true,
      "insertTextpool": true,
      "kernelCall": true,
      "systemCall": true
    },
    "description_empty": true,
    "dynpro_checks": true,
    "easy_to_find_messages": true,
    "else_after_all_returns": true,
    "empty_event": true,
    "empty_structure": {
      "at": true,
      "case": true,
      "catch": true,
      "do": true,
      "if": true,
      "loop": false,
      "select": true,
      "try": true,
      "when": false,
      "while": true
    },
    "exit_or_check": true,
    "expand_macros": true,
    "fm_global_parameters_obsolete": true,
    "forbidden_identifier": true,
    "forbidden_pseudo_and_pragma": {
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false,
      "pragmas": [],
      "pseudo": []
    },
    "forbidden_void_type": {
      "check": [
        "^boole_d$",
        "^char10$",
        "^char12$",
        "^char2$",
        "^char20$",
        "^char30$",
        "^char4$",
        "^char50$",
        "^char70$",
        "^cl_abap_syst",
        "^cl_aff_",
        "^cl_aucv_test_runner_abstract$",
        "^cl_aucv_test_runner_standard$",
        "^cl_aunit_assert$",
        "^cl_axt_dbtable$",
        "^cl_blue_wb_utility$",
        "^cl_oo_source$",
        "^/ui2/cl_",
        "^cl_saunit_internal_result$",
        "^cl_srvd_wb_object_data$",
        "^cl_wb_object_operator_factory$",
        "^cl_wer_const$",
        "^cl_xco_",
        "^cx_aff_",
        "^cx_wb_object_operation_error$",
        "^cx_xco_",
        "^flag$",
        "^i18_a_langiso2$",
        "^if_adt_lock_handle$",
        "^if_aff_",
        "^if_satc_ci_variant_access$",
        "^if_saunit_internal_result$",
        "^if_saunit_internal_result_type$",
        "^if_srvd_types$",
        "^if_wb_adt_plugin_resource_co$",
        "^if_wb_object_data_selection_co$",
        "^if_wb_object_operator$",
        "^if_xco_",
        "^int4$",
        "^numc2$",
        "^sabp_t_tadir_keys$",
        "^sap_bool$",
        "^srcsystem$",
        "^stringtab$",
        "^sychar01$",
        "^sychar10$",
        "^sychar70$",
        "^sydatum$",
        "^sylangu$",
        "^syst_title$",
        "^syuzeit$",
        "^feld$",
        "^abap_boolean$"
      ]
    },
    "form_tables_obsolete": true,
    "fully_type_constants": {"checkData": true},
    "fully_type_itabs": true,
    "function_module_recommendations": true,
    "identical_descriptions": true,
    "identical_form_names": true,
    "identical_move": true,
    "if_in_if": true,
    "implicit_start_of_selection": true,
    "index_completely_contained": true,
    "inline_data_old_versions": true,
    "intf_referencing_clas": {"allow": ["^cl_abap_"]},
    "invalid_table_index": true,
    "line_break_style": true,
    "local_testclass_consistency": true,
    "macro_naming": true,
    "main_file_contents": true,
    "many_parentheses": true,
    "max_one_method_parameter_per_line": true,
    "message_exists": true,
    "method_overwrites_builtin": true,
    "mix_returning": true,
    "modify_only_own_db_tables": {"ownTables": "^[yz]", "reportDynamic": true},
    "msag_consistency": true,
    "nesting": {"depth": 5},
    "newline_between_methods": true,
    "no_aliases": true,
    "no_comments_between_methods": true,
    "no_external_form_calls": true,
    "nrob_consistency": true,
    "omit_preceding_zeros": true,
    "omit_receiving": true,
    "parser_702_chaining": true,
    "parser_bad_exceptions": true,
    "parser_missing_space": true,
    "pragma_style": true,
    "prefer_abap_bool": true,
    "prefer_abap_bool_values": true,
    "prefer_pragmas": true,
    "prefer_raise_exception_new": true,
    "prefer_returning_to_exporting": true,
    "prefer_xsdbool": true,
    "preferred_parameter_ignored": true,
    "prefix_is_current_class": {"severity": "Warning"},
    "reduce_procedural_code": true,
    "reduce_string_templates": true,
    "redundant_conversion": true,
    "release_idoc": true,
    "remove_descriptions": {"ignoreExceptions": false, "ignoreWorkflow": false},
    "rfc_error_handling": true,
    "select_add_order_by": true,
    "select_performance": true,
    "select_single_full_key": true,
    "selection_screen_naming": true,
    "short_case": true,
    "sicf_consistency": true,
    "slow_parameter_passing": true,
    "sql_escape_host_variables": true,
    "sql_value_conversion": true,
    "static_call_via_instance": {"allowInTestclassIncludes": false},
    "strict_sql": true,
    "superfluous_value": true,
    "sy_modification": true,
    "tabl_enhancement_category": true,
    "tables_declared_locally": true,
    "try_without_catch": true,
    "type_form_parameters": true,
    "uncaught_exception": true,
    "unnecessary_chaining": true,
    "unnecessary_loop_guard": true,
    "unnecessary_pragma": true,
    "unnecessary_return": true,
    "unsecure_fae": true,
    "unused_ddic": true,
    "unused_macros": true,
    "use_bool_expression": true,
    "use_class_based_exceptions": true,
    "use_message_class": true,
    "use_new": true,
    "xml_bom": true
  }
}
